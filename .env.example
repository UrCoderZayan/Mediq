# Required for the server-side AI proxy. Never put this value in index.html or script.js.
GROQ_API_KEY=

# Optional model override.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional persistent profile/chat storage. Without this, profile fallback storage is used locally.
DATABASE_URL=

# Optional compatible server-side LLM fallback.
CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=